class MusifySoLoudHandler extends BaseAudioHandler
    with QueueHandler, SeekHandler {
  final SoLoud _soloud = SoLoud.instance;

  AudioSource? _currentSource;
  SoundHandle? _activeHandle;

  Timer? _positionSyncTimer;
